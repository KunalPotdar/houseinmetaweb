# House In Meta - Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000

# ============================================
# GMAIL CONFIGURATION
# ============================================
# Google Workspace email address used to send form emails
GMAIL_USER=amruta@houseinmeta.com

# Google App Password (NOT your regular account password)
# To create an App Password:
# 1. Go to https://myaccount.google.com/
# 2. Click "Security" in the left sidebar
# 3. Enable "2-Step Verification" if not already enabled
# 4. Click "App passwords" (only visible if 2-Step Verification is on)
# 5. Select "Mail" and "Windows Computer" (or your device)
# 6. Google will generate a 16-character password
# 7. Copy that password here (remove spaces)
GMAIL_APP_PASSWORD=your-16-character-app-password

# Support email for reply-to header
SUPPORT_EMAIL=amruta@houseinmeta.com

# Contact form recipient email
CONTACT_RECEIVER_EMAIL=amruta@houseinmeta.com

# ============================================
# DATABASE CONFIGURATION (Optional - for future use)
# ============================================
# DATABASE_URL=mongodb://localhost:27017/houseinmeta
# DATABASE_USER=
# DATABASE_PASSWORD=

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=debug
